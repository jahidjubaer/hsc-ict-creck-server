NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ict-crack
CLIENT_URL=http://localhost:5180,http://127.0.0.1:5180
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
TRIAL_DAYS=15
# AI grading (Gemini free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative provider
ANTHROPIC_API_KEY=
AI_GRADER_MODEL=claude-sonnet-5-5

# auto = Gemini if GEMINI_API_KEY is set, else Anthropic, else students self-mark against the model answer
AI_PROVIDER=auto
AI_DAILY_LIMIT=40

# Payment numbers students "Send Money" to (personal) or "Payment" to (merchant). Editable later in /admin/settings.
BKASH_NUMBER=
BKASH_ACCOUNT_TYPE=personal
NAGAD_NUMBER=
NAGAD_ACCOUNT_TYPE=personal
